<UserControl x:Class="JumperTools.UI.Views.Tabs.SignalRepairTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header Toolbar & Modem Live Status -->
            <RowDefinition Height="Auto"/> <!-- Row 1: 2 Balanced 50:50 SoC Control Panels -->
            <RowDefinition Height="*"/>    <!-- Row 2: Live Modem & Diag Stream Terminal (Zero Void) -->
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER TOOLBAR & LIVE MODEM / RADIO DIAGNOSTICS -->
        <Border Grid.Row="0" Style="{StaticResource ModernEnterpriseCard}" Padding="14,10" Margin="0,0,0,8">
            <DockPanel>
                <!-- Title & Guide -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📶" FontSize="14" Margin="0,0,6,0" Foreground="#0284C7"/>
                    <TextBlock Text="Perbaikan Sinyal, Baseband &amp; IMEI" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                    <Button Style="{StaticResource SmallInfoBadgeButton}" Command="{Binding ShowFeatureGuideCommand}" CommandParameter="Tab_SignalRepair" ToolTip="Panduan Perbaikan Sinyal" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Live Radio Modem Status & Check CTA -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Baseband Status Badge -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Baseband: " FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding BasebandVersion, FallbackValue='Belum dibaca'}" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                        </StackPanel>
                    </Border>

                    <!-- IMEI Status Badge -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IMEI: " FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ImeiStatusSummary, FallbackValue='Standby'}" FontWeight="Bold" FontSize="11" Foreground="#0284C7"/>
                        </StackPanel>
                    </Border>

                    <!-- Radio Power Status Badge -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Radio: " FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding RadioPowerState, FallbackValue='Unknown'}" FontWeight="Bold" FontSize="11" Foreground="#15803D"/>
                        </StackPanel>
                    </Border>

                    <!-- Check Signal Button -->
                    <Button Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" BorderBrush="#0284C7" 
                            Content="🔍 Periksa Sinyal" Command="{Binding CheckBasebandRadioCommand}" Padding="14,6" FontSize="11.5" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: 2 BALANCED 50:50 SoC PANELS (ZERO VOID & FULL WIDTH) -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL 1: QUALCOMM DIAG & KALIBRASI QCN (LEFT 50%) -->
            <Border Grid.Column="0" Style="{StaticResource ModernEnterpriseCard}" Padding="16,14" Margin="0,0,4,0">
                <StackPanel>
                    <!-- Header -->
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔴" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="QUALCOMM DIAG &amp; KALIBRASI QCN" FontWeight="Bold" FontSize="12" Foreground="#B45309"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Port Diag Selector -->
                    <TextBlock Text="Port Qualcomm Diag (COM):" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                                  ItemsSource="{Binding DiagComPorts}" SelectedItem="{Binding SelectedDiagPort, UpdateSourceTrigger=PropertyChanged}" 
                                  materialDesign:HintAssist.Hint="Pilih Port COM..." materialDesign:HintAssist.IsFloating="False"
                                  Height="36" FontSize="11.5" VerticalContentAlignment="Center" Background="#FFFFFF"/>
                        <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="🔄 Scan COM" Command="{Binding ScanDiagPortsCommand}" Margin="6,0,0,0" Padding="10,4" FontSize="11"/>
                        <Button Grid.Column="2" Style="{StaticResource ModernActionButton}" Content="⚡ Aktifkan Diag (ADB)" Command="{Binding EnableQualcommDiagPortCommand}" Margin="6,0,0,0" Padding="10,4" FontSize="11" ToolTip="Aktifkan port Diag Qualcomm via ADB"/>
                    </Grid>

                    <!-- QCN Official Catalog Dropdown -->
                    <TextBlock Text="Pilih QCN dari Katalog Resmi:" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                              ItemsSource="{Binding QcnFiles}" SelectedItem="{Binding SelectedQcnFile, UpdateSourceTrigger=PropertyChanged}" 
                              materialDesign:HintAssist.Hint="Pilih model QCN bawaan (Oppo, Realme, Samsung)..." materialDesign:HintAssist.IsFloating="False"
                              Height="36" FontSize="11.5" VerticalContentAlignment="Center" Background="#FFFFFF" Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Brand}" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,8,0"/>
                                    <TextBlock Text="• " Foreground="#94A3B8" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Chipset}" Foreground="#64748B" FontSize="10.5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Custom QCN File Picker -->
                    <TextBlock Text="Atau File QCN Kustom (*.qcn):" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CustomQcnFilePath, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource SharpTextBox}" materialDesign:HintAssist.Hint="Pilih file .qcn manual..." Height="32" FontSize="11" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="📂 Cari .qcn" Command="{Binding BrowseCustomQcnCommand}" Margin="0,0,4,0" Padding="10,4" FontSize="11"/>
                        <Button Grid.Column="2" Style="{StaticResource ModernActionButton}" Content="🗑️" Command="{Binding ClearCustomQcnCommand}" Padding="8,4" FontSize="11" ToolTip="Reset file"/>
                    </Grid>

                    <!-- Execute Write QCN -->
                    <Button Style="{StaticResource ModernPrimaryButton}" Background="#16A34A" BorderBrush="#16A34A" 
                            Command="{Binding RestoreSelectedQCNCommand}" Height="36" FontSize="12" FontWeight="Bold"
                            ToolTip="Tulis file QCN ke partisi modem Qualcomm via Port Diag">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📶" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="Tulis QCN / Pulihkan Sinyal Qualcomm"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- PANEL 2: MEDIATEK NVRAM / NVDATA (RIGHT 50%) -->
            <Border Grid.Column="1" Style="{StaticResource ModernEnterpriseCard}" Padding="16,14" Margin="4,0,0,0">
                <StackPanel>
                    <!-- Header -->
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔵" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="MEDIATEK NVRAM / NVDATA &amp; BASEBAND" FontWeight="Bold" FontSize="12" Foreground="#0369A1"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Manajemen partisi kalibrasi radio modem &amp; perbaikan IMEI via META Mode / BROM:" FontSize="11" Foreground="#64748B" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- Action Buttons -->
                    <Button Style="{StaticResource ModernPrimaryButton}" Background="#16A34A" BorderBrush="#16A34A" 
                            Command="{Binding BackupMtkMetaNvramCommand}" Height="36" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                            ToolTip="Backup partisi NVRAM / NVDATA via META Mode atau BROM">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="Backup NVRAM / NVDATA (Pengamanan Partisi)"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" BorderBrush="#0284C7" 
                            Command="{Binding RestoreMtkMetaNvramCommand}" Height="36" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                            ToolTip="Restore partisi NVRAM / NVDATA via META Mode atau BROM">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="Restore NVRAM / NVDATA (Pemulihan Partisi)"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModernActionButton}" 
                            Command="{Binding WriteMtkImeiMetaCommand}" Height="36" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"
                            ToolTip="Tulis ulang IMEI 1 &amp; 2 via META Mode">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✍️" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="Tulis / Perbaiki IMEI MTK (META Mode)"/>
                        </StackPanel>
                    </Button>

                    <!-- Informational Note -->
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10,8">
                        <TextBlock Text="💡 Petunjuk: Pastikan driver MediaTek VCOM &amp; CDC-ACM terpasang untuk operasi META Mode / BROM tanpa hambatan." Foreground="#475569" FontSize="10.5" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: LIVE MODEM & DIAG LOG STREAM TERMINAL (ZERO VOID) -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Terminal Header Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="LOG TERMINAL MODEM &amp; DIAGNOSTIK SINYAL / AT-COMMAND" FontWeight="Bold" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModernActionButton}" Command="{Binding CopyLogCommand}" Padding="10,4" FontSize="10.5" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Margin="0,0,6,0" FontSize="10.5"/>
                                <TextBlock Text="Salin Log"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModernActionButton}" Command="{Binding ClearLogCommand}" Padding="10,4" FontSize="10.5" Background="#334155" Foreground="#FCA5A5" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" Margin="0,0,6,0" FontSize="10.5"/>
                                <TextBlock Text="Bersihkan"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Terminal Log Body -->
                <TextBox Grid.Row="1" Text="{Binding TerminalLogText, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#38BDF8"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12"
                         FontWeight="Medium"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         SelectionBrush="#0284C7"
                         Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
