<UserControl x:Class="JumperTools.UI.Views.Tabs.TestPointTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: SEARCH & MODEL LIST -->
        <Border Grid.Column="0" Style="{StaticResource ModernEnterpriseCard}" Padding="12" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search Box -->
                    <RowDefinition Height="Auto"/> <!-- Brand Filter Pills -->
                    <RowDefinition Height="*"/>    <!-- Compact List -->
                </Grid.RowDefinitions>

                <!-- Search Input with Clear Hint -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <DockPanel Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📍" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Database Model Test Point" FontWeight="Bold" FontSize="12.5" Foreground="#7E22CE"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallInfoBadgeButton}" Command="{Binding ShowFeatureGuideCommand}" CommandParameter="Tab_TestPointHub" ToolTip="Panduan &amp; Diagram Test Point"/>
                    </DockPanel>
                    <TextBox Text="{Binding TestPointSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource SharpTextBox}" materialDesign:HintAssist.Hint="🔍 Cari tipe HP (contoh: Note 8, A5s, Y12)..." Height="32" FontSize="11.5" Padding="8,6"/>
                </StackPanel>

                <!-- Brand Filter Quick Buttons -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button Content="Semua" Style="{StaticResource FilterTagButton}" Command="{Binding SearchTestPointCommand}" CommandParameter=""/>
                    <Button Content="Xiaomi" Style="{StaticResource FilterTagButton}" Command="{Binding SearchTestPointCommand}" CommandParameter="Xiaomi"/>
                    <Button Content="Oppo" Style="{StaticResource FilterTagButton}" Command="{Binding SearchTestPointCommand}" CommandParameter="Oppo"/>
                    <Button Content="Vivo" Style="{StaticResource FilterTagButton}" Command="{Binding SearchTestPointCommand}" CommandParameter="Vivo"/>
                    <Button Content="Samsung" Style="{StaticResource FilterTagButton}" Command="{Binding SearchTestPointCommand}" CommandParameter="Samsung"/>
                    <Button Content="Realme" Style="{StaticResource FilterTagButton}" Command="{Binding SearchTestPointCommand}" CommandParameter="Realme"/>
                    <Button Content="Infinix" Style="{StaticResource FilterTagButton}" Command="{Binding SearchTestPointCommand}" CommandParameter="Infinix"/>
                    <Button Content="Huawei" Style="{StaticResource FilterTagButton}" Command="{Binding SearchTestPointCommand}" CommandParameter="Huawei"/>
                </WrapPanel>

                <!-- Compact, Clean Model List -->
                <ListView Grid.Row="2" ItemsSource="{Binding TestPoints}" SelectedItem="{Binding SelectedTestPoint}" 
                          ItemContainerStyle="{StaticResource CleanListViewItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <TextBlock Text="{Binding MarketingName}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource TagBlueBg}" BorderBrush="{StaticResource TagBlueBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Brand}" Foreground="{StaticResource TagBlueText}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>

                                    <DockPanel Grid.Row="1" Margin="0,3,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource TagPurpleBg}" BorderBrush="{StaticResource TagPurpleBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Type}" Foreground="{StaticResource TagPurpleText}" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Chipset}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Codename}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- RIGHT COLUMN: SCHEMATIC BLUEPRINT & STEP-BY-STEP INSTRUCTIONS -->
        <Border Grid.Column="1" Style="{StaticResource ModernEnterpriseCard}" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header Bar -->
                    <RowDefinition Height="*"/>    <!-- Blueprint & Content (Full Height, Zero Void) -->
                </Grid.RowDefinitions>

                <!-- Header Bar with Clear CTAs -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedTestPoint.MarketingName, TargetNullValue='Pilih Model HP'}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SelectedTestPoint.Codename, StringFormat=' ({0})'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- CTA 1: Import Foto TP -->
                        <Button Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" BorderBrush="#0284C7"
                                Command="{Binding ImportTestPointImageCommand}" Padding="10,4" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" ToolTip="Pasang atau ganti foto diagram motherboard asli dari komputer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷" Margin="0,0,4,0" FontSize="11"/>
                                <TextBlock Text="Pasang Foto TP"/>
                            </StackPanel>
                        </Button>

                        <!-- CTA 2: Folder Foto TP -->
                        <Button Style="{StaticResource ModernActionButton}" Command="{Binding OpenTestPointFolderCommand}" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Buka folder direktori penyimpanan foto database/testpoint/">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" Margin="0,0,4,0" FontSize="11"/>
                                <TextBlock Text="Folder Foto"/>
                            </StackPanel>
                        </Button>

                        <!-- CTA 3: Sync Cloud -->
                        <Button Style="{StaticResource ModernActionButton}" Command="{Binding SyncTestPointsCommand}" Padding="8,4" FontSize="11" Margin="0,0,8,0" ToolTip="Perbarui diagram Test Point dari server JumperTools">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,4,0" FontSize="11"/>
                                <TextBlock Text="Sync"/>
                            </StackPanel>
                        </Button>

                        <Border Background="{StaticResource TagBlueBg}" BorderBrush="{StaticResource TagBlueBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock Text="{Binding SelectedTestPoint.Brand, TargetNullValue='-'}" Foreground="{StaticResource TagBlueText}" FontWeight="Bold" FontSize="11.5"/>
                        </Border>
                        <Border Background="{StaticResource TagPurpleBg}" BorderBrush="{StaticResource TagPurpleBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="{Binding SelectedTestPoint.Type, TargetNullValue='-'}" Foreground="{StaticResource TagPurpleText}" FontWeight="Bold" FontSize="11.5"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Full Height Content Grid (Zero Void) -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Visual Blueprint / Real Photo Box -->
                        <RowDefinition Height="*"/>    <!-- Instructions Cards (Fills Remaining Space) -->
                    </Grid.RowDefinitions>

                    <!-- VISUAL MOTHERBOARD PHOTO / VECTOR SCHEMATIC BLUEPRINT -->
                    <Border Grid.Row="0" Background="#0B1329" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="12">
                        <Grid>
                            <!-- 1. REAL MOTHERBOARD PHOTO (When Image Exists) -->
                            <Grid Visibility="{Binding HasTestPointImage, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                                        <TextBlock Text="FOTO ASLI MOTHERBOARD &amp; TITIK TEST POINT FISIK" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" FontFamily="Consolas, Cascadia Code"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ModernActionButton}" Command="{Binding RemoveTestPointImageCommand}" 
                                            Background="#1E293B" Foreground="#FCA5A5" BorderThickness="0" Padding="6,2" FontSize="10" HorizontalAlignment="Right" ToolTip="Hapus foto dan kembali ke skematik vektor">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑️" Margin="0,0,4,0" FontSize="10"/>
                                            <TextBlock Text="Gunakan Skematik"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>

                                <Border Grid.Row="1" Background="#020617" CornerRadius="6" Padding="6" HorizontalAlignment="Center">
                                    <Image Source="{Binding TestPointImageSource}" Stretch="Uniform" MaxHeight="320" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- 2. INTERACTIVE VECTOR MOTHERBOARD PINOUT BLUEPRINT (Fallback When No Photo) -->
                            <Grid Visibility="{Binding HasNoTestPointImage, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Diagram Header Bar -->
                                <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="12,7" Margin="0,0,0,10">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                                            <TextBlock Text="📍 HARDWARE TEST POINT LOCATOR &amp; SCHEMATIC BLUEPRINT" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11.5" FontFamily="Consolas, Cascadia Code"/>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ModernActionButton}" Command="{Binding ImportTestPointImageCommand}" 
                                                Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Padding="8,2" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" ToolTip="Pasang foto asli motherboard untuk model ini">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📷" Margin="0,0,4,0" FontSize="10.5"/>
                                                <TextBlock Text="+ Pasang Foto Asli"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </Border>

                                <!-- Vector Motherboard Visual PCB Layout -->
                                <Border Grid.Row="1" Background="#061826" BorderBrush="#0E3954" BorderThickness="2" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: PCB Schematic Block Diagram -->
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- CPU Shield Block -->
                                            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="5" Padding="10,12" Margin="0,0,8,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="⚙️ SOC CHIP" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SelectedTestPoint.Chipset}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- eMMC / UFS Shield Block (Expanded, No Text Cut-Off) -->
                                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="5" Padding="10,12" Margin="0,0,8,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="💾 MEMORY / STORAGE" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="eMMC / UFS ROM" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- FPC Sockets -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                                    <TextBlock Text="🔌 SOKET BATERAI (BATTERY FPC)" Foreground="#A7F3D0" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                                    <TextBlock Text="📱 SOKET LCD &amp; SUB-BOARD" Foreground="#CBD5E1" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Right: Golden Test Point Target Probe -->
                                        <Border Grid.Column="1" Background="#1E293B" BorderBrush="#D97706" BorderThickness="1.5" CornerRadius="6" Padding="16,10" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="⚡ TARGET TITIK EMAS" Foreground="#FDE68A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                                                    <Border Width="18" Height="18" CornerRadius="9" Background="#F59E0B" BorderBrush="#FDE68A" BorderThickness="2" Margin="0,0,8,0" ToolTip="TP 1 (Test Point Data/CLK)"/>
                                                    <Border Width="18" Height="18" CornerRadius="9" Background="#F59E0B" BorderBrush="#FDE68A" BorderThickness="2" ToolTip="TP 2 (GND / Ground)"/>
                                                </StackPanel>
                                                <Border Background="#D97706" CornerRadius="3" Padding="8,2">
                                                    <TextBlock Text="JUMPER PINSET" Foreground="#FFFBEB" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Physical Location HUD Card -->
                                <Border Grid.Row="2" Background="#111827" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📍 POSISI FISIK DI MOTHERBOARD:" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedTestPoint.TestPointLocation, TargetNullValue='Lihat instruksi di bawah'}" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Mode:" Foreground="#94A3B8" FontSize="10.5" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SelectedTestPoint.Type, TargetNullValue='-'}" Foreground="#A78BFA" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- INSTRUCTIONS SECTION (BALANCED 2-COLUMN OR FLUSH DOCKED) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Jumper Steps Card -->
                        <Border Grid.Column="0" Background="{StaticResource TagAmberBg}" BorderBrush="{StaticResource TagAmberBorder}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,6,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="📋 Langkah Jumper Step-by-Step:" FontWeight="Bold" Foreground="{StaticResource TagAmberText}" FontSize="12" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedTestPoint.Instructions, TargetNullValue='-'}" TextWrapping="Wrap" LineHeight="20" FontSize="11.5" Foreground="#451A03"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- SOP & Safety Card -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="ℹ️ Standar Operasional &amp; Keamanan (SOP):" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                    <TextBlock Text="• Gunakan pinset berujung runcing dan presisi saat menghubungkan titik test point ke Ground (GND/Kaleng pelindung).&#x0a;&#x0a;• Lepaskan baterai HP terlebih dahulu sebelum menghubungkan pinset.&#x0a;&#x0a;• Tahan jumper pinset, lalu colokkan kabel USB ke PC hingga terdeteksi di Device Manager (Qualcomm 9008 / MediaTek VCOM).&#x0a;&#x0a;• Setelah terdeteksi, segera lepas pinset dan pasang kembali konektor baterai." 
                                               TextWrapping="Wrap" LineHeight="18" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
