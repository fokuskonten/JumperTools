<UserControl x:Class="JumperTools.UI.Views.Tabs.FirmwareFlasherTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Form Input File ROM (Multi-Protocol Flasher) -->
        <Border Grid.Column="0" Style="{StaticResource ModernEnterpriseCard}" Padding="12" Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Card Auto-ROM Downloader (Official CDN) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Auto-ROM Downloader" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                        <TextBlock Text="Official CDN" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155"/>
                                    </Border>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ModernActionButton}" Content="⚡ Auto-Detect HP" Command="{Binding AutoDetectDeviceForRomCommand}" ToolTip="Deteksi otomatis model &amp; region dari HP yang terhubung via USB" HorizontalAlignment="Right" Padding="6,2" FontSize="9.5"/>
                            </DockPanel>

                            <!-- Brand Selector -->
                            <TextBlock Text="Pabrikan Server:" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding AutoRomBrandList}" SelectedItem="{Binding SelectedAutoRomBrand, Mode=TwoWay}" Height="26" FontSize="10.5" FontWeight="SemiBold" Background="#FFFFFF" Margin="0,0,0,6"/>

                            <!-- Model & Region Grid -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Model / Codename:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,1"/>
                                    <TextBox Text="{Binding AutoRomModelInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="26" FontSize="10.5" materialDesign:HintAssist.Hint="SM-A125F / begonia..."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Region/CSC:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,1"/>
                                    <TextBox Text="{Binding AutoRomRegionInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="26" FontSize="10.5" materialDesign:HintAssist.Hint="XID / id..."/>
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons -->
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource ModernActionButton}" Content="🔍 Cek Versi" Command="{Binding CheckOfficialRomCommand}" Margin="0,0,3,0" Padding="4,3" FontSize="10.5"/>
                                <Button Grid.Column="1" Style="{StaticResource ModernPrimaryButton}" Content="⚡ Unduh &amp; Pasang" Command="{Binding StartDownloadAutoRomCommand}" IsEnabled="{Binding CanStartAutoRomDownload}" Margin="3,0,0,0" Padding="4,3" FontSize="10.5"/>
                            </Grid>

                            <!-- Version Info Banner -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,6" Visibility="{Binding IsAutoRomFound, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding AutoRomFoundVersionInfo}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Status & Progress -->
                            <TextBlock Text="{Binding AutoRomStatusText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <!-- Progress Bar (When Downloading) -->
                            <StackPanel Visibility="{Binding IsAutoRomDownloading, Converter={StaticResource BoolToVisConverter}}" Margin="0,2,0,0">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Progress Unduhan:" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding AutoRomSpeedText}" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding AutoRomDownloadProgress}" Height="6" Foreground="#22C55E" Background="#E2E8F0" Margin="0,0,0,4"/>
                                <Button Style="{StaticResource ModernActionButton}" Content="✕ Batalkan Unduhan" Command="{Binding CancelDownloadAutoRomCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="9.5" Foreground="#DC2626"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Konfigurasi File Firmware" FontWeight="Bold" FontSize="13" Foreground="#B45309"/>
                            <Button Style="{StaticResource SmallInfoBadgeButton}" Command="{Binding ShowFeatureGuideCommand}" CommandParameter="Samsung_FlashOdin" ToolTip="Panduan Flasher Firmware"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Protocol Flasher Selector -->
                    <TextBlock Text="Tipe Flasher:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding FlasherProtocolList}" SelectedIndex="{Binding SelectedFlasherTabIndex, Mode=TwoWay}" Height="28" FontSize="11" FontWeight="Bold" VerticalContentAlignment="Center" Background="#FFFFFF" Margin="0,0,0,10"/>

                    <!-- 0: 4-File Odin Form (Samsung) -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Visibility="{Binding IsSamsungFlasherSelected, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Samsung 4-File Odin (TAR.MD5)" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ModernActionButton}" Content="🧹 Reset" Command="{Binding ClearSamsungOdinFilesCommand}" Padding="6,2" FontSize="10"/>
                            </DockPanel>

                            <!-- BL -->
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Width="38">
                                    <TextBlock Text="BL" FontWeight="Bold" Foreground="#0369A1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Text="{Binding SamsungBlPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="4,0,6,0" materialDesign:HintAssist.Hint="BL_*.tar.md5..."/>
                                <Button Grid.Column="2" Style="{StaticResource ModernActionButton}" Content="📂 Pilih" Command="{Binding BrowseSamsungBlCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>

                            <!-- AP -->
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Width="38">
                                    <TextBlock Text="AP" FontWeight="Bold" Foreground="#0369A1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Text="{Binding SamsungApPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="4,0,6,0" materialDesign:HintAssist.Hint="AP_*.tar.md5..."/>
                                <Button Grid.Column="2" Style="{StaticResource ModernActionButton}" Content="📂 Pilih" Command="{Binding BrowseSamsungApCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>

                            <!-- CP -->
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Width="38">
                                    <TextBlock Text="CP" FontWeight="Bold" Foreground="#0369A1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Text="{Binding SamsungCpPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="4,0,6,0" materialDesign:HintAssist.Hint="CP_*.tar.md5..."/>
                                <Button Grid.Column="2" Style="{StaticResource ModernActionButton}" Content="📂 Pilih" Command="{Binding BrowseSamsungCpCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>

                            <!-- CSC -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Width="38">
                                    <TextBlock Text="CSC" FontWeight="Bold" Foreground="#0369A1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Text="{Binding SamsungCscPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="4,0,6,0" materialDesign:HintAssist.Hint="CSC_*.tar.md5..."/>
                                <Button Grid.Column="2" Style="{StaticResource ModernActionButton}" Content="📂 Pilih" Command="{Binding BrowseSamsungCscCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 1: MediaTek Scatter & DA/Auth Form -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Visibility="{Binding IsMtkFlasherSelected, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="MediaTek Scatter &amp; DA Loader" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            
                            <!-- Scatter File -->
                            <TextBlock Text="Berkas Scatter (*.txt):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MtkScatterPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="0,0,6,0" materialDesign:HintAssist.Hint="Pilih MT6xxx_Android_scatter.txt..."/>
                                <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="📂 Scatter..." Command="{Binding BrowseMtkScatterCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>

                            <!-- Custom DA -->
                            <TextBlock Text="Custom Download Agent (DA):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MtkCustomDaFileName, Mode=OneWay}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" IsReadOnly="True" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="Pilih DA..." Command="{Binding MtkBrowseCustomDaCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>

                            <!-- Custom Auth -->
                            <TextBlock Text="Custom Auth File (*.auth):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MtkCustomAuthFileName, Mode=OneWay}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" IsReadOnly="True" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="Pilih Auth..." Command="{Binding MtkBrowseCustomAuthCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2: Qualcomm EDL RawProgram XML Form -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Visibility="{Binding IsQualcommFlasherSelected, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Qualcomm EDL 9008 Flasher (XML)" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                            <!-- RawProgram XML -->
                            <TextBlock Text="RawProgram XML (*rawprogram*.xml):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding QualcommRawProgramPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="0,0,6,0" materialDesign:HintAssist.Hint="rawprogram0.xml..."/>
                                <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="📂 Raw..." Command="{Binding BrowseQualcommRawProgramCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>

                            <!-- Patch XML -->
                            <TextBlock Text="Patch XML (*patch*.xml):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding QualcommPatchPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="0,0,6,0" materialDesign:HintAssist.Hint="patch0.xml..."/>
                                <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="📂 Patch..." Command="{Binding BrowseQualcommPatchCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>

                            <!-- Firehose Programmer -->
                            <TextBlock Text="Firehose Loader (*.mbn;*.elf):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding QualcommFirehosePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="0,0,6,0" materialDesign:HintAssist.Hint="prog_emmc_firehose_*.mbn..."/>
                                <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="📂 Prog..." Command="{Binding BrowseQualcommFirehoseCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3: Unisoc PAC Flasher Form -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Visibility="{Binding IsUnisocFlasherSelected, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Unisoc / Spreadtrum PAC Firmware" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding UnisocPacPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="0,0,6,0" materialDesign:HintAssist.Hint="Pilih berkas .PAC firmware..."/>
                                <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="📂 Pilih" Command="{Binding BrowseUnisocPacCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4: Fastboot / Universal Multi-Partisi Form -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Visibility="{Binding IsFastbootFlasherSelected, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Fastboot Multi-Partisi / Folder Firmware" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding FirmwarePathInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Height="28" FontSize="10.5" Margin="0,0,6,0" materialDesign:HintAssist.Hint="Folder ROM / images / zip..."/>
                                <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="📂 Pilih" Command="{Binding BrowseFirmwareFileCommand}" Padding="6,2" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Flashing Options -->
                    <TextBlock Text="Opsi Flashing:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                    <!-- PERBAIKAN P5-3: Checkbox benar-benar terikat ke ViewModel properties -->
                    <CheckBox Content="Auto Reboot setelah Flashing Sukses" IsChecked="{Binding AutoRebootAfterFlash, Mode=TwoWay}" Foreground="#0F172A" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                    <CheckBox Content="Wipe Userdata (Format Data Bersih)" IsChecked="{Binding WipeUserdataOnFlash, Mode=TwoWay}" Foreground="#DC2626" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5" ToolTip="PERHATIAN: Menghapus semua data pengguna setelah flash selesai!"/>
                    <CheckBox Content="Backup NVRAM / Security sebelum Flashing" IsChecked="{Binding BackupNvramBeforeFlash, Mode=TwoWay}" Foreground="#0F172A" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8" ToolTip="Tampilkan pengingat backup NVRAM/IMEI di log sebelum flash dimulai"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT: Partition Table Checklist & Flashing CTA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Flashing Action Header Card -->
            <Border Grid.Row="0" Style="{StaticResource ModernEnterpriseCard}" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Eksekusi Flashing Firmware" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                        <TextBlock Text="Pastikan HP terhubung dalam mode yang sesuai (Download Mode / BROM / EDL 9008 / Fastboot)." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="Pastikan HP terhubung dalam mode yang sesuai (Download Mode / BROM / EDL 9008 / Fastboot)." Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- PERBAIKAN P5-4: IsEnabled terikat ke IsDeviceConnected — flash disabled jika HP tidak terdeteksi -->
                        <Button Style="{StaticResource ModernPrimaryButton}" Background="#4F46E5" BorderBrush="#4F46E5" Content="⚡ Flash Multi-Partisi" Command="{Binding StartFirmwareFlashCommand}" Padding="9,4" FontSize="10.5" Margin="0,0,5,0" IsEnabled="{Binding IsDeviceConnected}" ToolTip="Flash seluruh partisi firmware yang dicentang via Fastboot/Raw"/>
                        <Button Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" BorderBrush="#0284C7" Content="⚡ Flash Bit (EDL)" Command="{Binding SamsungEdlFlashBitCommand}" Padding="8,4" FontSize="10.5" Margin="0,0,5,0" IsEnabled="{Binding IsDeviceConnected}" ToolTip="Flash bootloader bit loader via mode Qualcomm EDL 9008"/>
                        <Button Style="{StaticResource ModernPrimaryButton}" Background="#16A34A" BorderBrush="#16A34A" Content="⚡ Flash PAC" Command="{Binding FlashUnisocPacCommand}" Padding="8,4" FontSize="10.5" Margin="0,0,5,0" IsEnabled="{Binding IsDeviceConnected}" ToolTip="Mulai flashing paket firmware Unisoc (.pac)"/>
                        <Button Style="{StaticResource ModernPrimaryButton}" Background="#D97706" BorderBrush="#D97706" Content="⚡ Mulai Flash Odin" Command="{Binding FlashSamsungOdinCommand}" Padding="12,4" FontSize="11" FontWeight="Bold" IsEnabled="{Binding IsDeviceConnected}" ToolTip="Mulai flashing Samsung 4-File (BL, AP, CP, CSC) — HP harus dalam mode Download Mode"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live Terminal Flashing Console -->
            <Border Grid.Row="1" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="8,8,0,0" Padding="12,7">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                                <TextBlock Text="FLASHING MONITOR &amp; LOG OUTPUT" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11" FontFamily="{StaticResource ConsoleFontFamily}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ModernActionButton}" Content="⏹️ Stop / Batal" Command="{Binding CancelCurrentOperationCommand}" Padding="10,3" FontSize="10.5" Background="#991B1B" Foreground="#FEF2F2" BorderThickness="0" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource ModernActionButton}" Content="📋 Salin Log" Command="{Binding CopyLogCommand}" Padding="10,3" FontSize="10.5" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource ModernActionButton}" Content="🧹 Bersihkan" Command="{Binding ClearLogCommand}" Padding="10,3" FontSize="10.5" Background="#334155" Foreground="#FCA5A5" BorderThickness="0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBox Grid.Row="1" Text="{Binding TerminalLogText, Mode=OneWay}"
                             Background="#0A0F1D" Foreground="#38BDF8"
                             FontFamily="{StaticResource ConsoleFontFamily}" FontSize="13.5"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Padding="12,10"
                             TextChanged="ConsoleTextBox_TextChanged"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
