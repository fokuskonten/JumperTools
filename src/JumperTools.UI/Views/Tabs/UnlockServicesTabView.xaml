<UserControl x:Class="JumperTools.UI.Views.Tabs.UnlockServicesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,2,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Hardware Status & Quick Target Bar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: 1-Click Platform Tab Strip -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Compact Service Action Canvas (Snug, Zero Void) -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Live Operation Progress -->
            <RowDefinition Height="*" MinHeight="180"/> <!-- Row 4: Docked Live Terminal Console (Fills 100% Canvas) -->
        </Grid.RowDefinitions>

        <!-- ROW 0: HARDWARE CONNECTION & TARGET MODEL BAR (ENLARGED & CLEAR) -->
        <Border Grid.Row="0" Style="{StaticResource ModernEnterpriseCard}" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Live Connected Device Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding DeviceStatusBgColor}" BorderBrush="{Binding DeviceStatusBorderColor}" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding DeviceStatusDotColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="USB: " FontWeight="Bold" FontSize="11.5" Foreground="{Binding DeviceStatusTextColor}"/>
                            <TextBlock Text="{Binding SelectedDevice.Model, FallbackValue='Menunggu HP Terhubung', TargetNullValue='Menunggu HP Terhubung'}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Port: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedDevice.DeviceId, FallbackValue='Auto COM / USB', TargetNullValue='Auto COM / USB'}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SoC: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedDevice.Chipset, FallbackValue='Auto Detect', TargetNullValue='Auto Detect'}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Target Phone Model Search -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                    <TextBlock Text="Target Model:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ModelSearchFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SharpTextBox}" Width="145" Height="30" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,0,6,0" materialDesign:HintAssist.Hint="Ketik seri HP..."/>
                    <ComboBox ItemsSource="{Binding FilteredModels}" SelectedItem="{Binding SelectedPhoneModel}" Width="210" Height="30" FontSize="11.5" VerticalContentAlignment="Center" Background="#FFFFFF" materialDesign:HintAssist.Hint="Pilih Model HP..." materialDesign:HintAssist.IsFloating="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Brand}" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding ModelName}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Right: Hardware Bus Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernPrimaryButton}" Content="🔄 Scan USB" Command="{Binding RefreshDevicesCommand}" Padding="14,6" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" ToolTip="Scan ulang port COM dan perangkat USB"/>
                    <Button Style="{StaticResource ModernSecondaryButton}" Content="⚡ Reset Port" Command="{Binding ForceResetUsbPortsCommand}" Padding="12,6" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" ToolTip="Restart port COM dan filter driver"/>
                    <Button Style="{StaticResource ModernActionButton}" Content="📂 Driver" Command="{Binding OpenDriversFolderCommand}" Padding="12,6" FontSize="11" ToolTip="Buka folder database installer driver USB"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: 1-CLICK PLATFORM TAB STRIP (LARGE & CLEAR TABS) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding ProtocolList}" SelectedIndex="{Binding SelectedBrandTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="10"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="Padding" Value="0,7"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ " FontSize="10.5" Foreground="#0284C7" x:Name="tbBolt"/>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                             <Setter TargetName="bd" Property="Background" Value="#F0F9FF"/>
                                             <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                             <Setter Property="Foreground" Value="#0284C7"/>
                                         </Trigger>
                                         <Trigger Property="IsSelected" Value="True">
                                             <Setter TargetName="bd" Property="Background" Value="#0284C7"/>
                                             <Setter TargetName="bd" Property="BorderBrush" Value="#0284C7"/>
                                             <Setter Property="Foreground" Value="#FFFFFF"/>
                                             <Setter TargetName="tbBolt" Property="Foreground" Value="#FFFFFF"/>
                                             <Setter Property="FontWeight" Value="Bold"/>
                                         </Trigger>
                                     </ControlTemplate.Triggers>
                                 </ControlTemplate>
                             </Setter.Value>
                         </Setter>
                     </Style>
                 </ListBox.ItemContainerStyle>
             </ListBox>
         </Border>

        <!-- ROW 2: COMPACT SERVICE ACTION CANVAS (SNUG, NO STRETCHING, 0-VOID) -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedBrandTabIndex, Mode=TwoWay}" BorderThickness="0" Background="Transparent" VerticalAlignment="Top" Margin="0,0,0,4">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- INDEX 0: ⚡ SAMSUNG (ODIN / AT / FRP) -->
            <TabItem>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: FRP & Screen Lock -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="🛡️ KUNCI LAYAR &amp; FRP" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="📋 Panduan *#0*# (Service Menu)" Command="{Binding BypassFrpSamsungServiceMenuCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Panduan langkah-langkah bypass FRP via kode darurat *#0*# — membutuhkan interaksi layar HP langsung"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="⚡ Bypass FRP (MTP ADB Auto)" Command="{Binding BypassFrpCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Kirim payload ADB otomatis via port AT Modem Samsung — HP harus sudah terdeteksi ADB atau terhubung MTP"/>
                            <Button Style="{StaticResource ModernDangerButton}" Content="🗑️ Factory Reset CSC" Command="{Binding SamsungFactoryResetCscCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Reset data pabrik via AT Command CSC"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Flash Bit (EDL 9008)" Command="{Binding SamsungEdlFlashBitCommand}" Height="34" FontSize="12" ToolTip="Flash bootloader bit loader via EDL"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Mode & Power -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="📥 MODE &amp; POWER CONTROL" FontWeight="Bold" FontSize="11" Foreground="#7E22CE" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="📥 Masuk Download Mode" Command="{Binding RebootDownloadCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Reboot MTP langsung ke Odin Download Mode"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔄 Reboot Normal (System)" Command="{Binding RebootNormalCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Reboot Recovery Mode" Command="{Binding RebootRecoveryCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="ℹ️ Read Device Info (AT)" Command="{Binding DeviceInfoCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Security & EFS -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="💾 KEAMANAN &amp; EFS SAMSUNG" FontWeight="Bold" FontSize="11" Foreground="#15803D" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernSuccessButton}" Content="💾 Backup EFS Partition" Command="{Binding SamsungBackupEfsCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Restore EFS Partition" Command="{Binding SamsungRestoreEfsCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📶 Fix Baseband / Radio" Command="{Binding FixBasebandCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📶 Repair / Write IMEI" Command="{Binding RepairImeiCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Special Samsung Operations -->
                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🛠️ LAYANAN ODIN &amp; KHUSUS" FontWeight="Bold" FontSize="11" Foreground="#B45309" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🛡️ Cek Knox / KG State" Command="{Binding SamsungKnoxCheckCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="⚡ Mulai Flash 4-File Odin" Command="{Binding FlashSamsungOdinCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🧹 Reset File Odin" Command="{Binding ClearSamsungOdinFilesCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Force Reset USB Port" Command="{Binding ForceResetUsbPortsCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- INDEX 1: ⚡ MEDIATEK (MTK BROM / PRELOADER) -->
            <TabItem>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: FRP & Format Userdata -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="🛡️ KUNCI LAYAR &amp; FRP" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="⚡ Erase FRP (BROM)" Command="{Binding MtkBypassFrpCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Hapus kunci akun Google via BROM"/>
                            <Button Style="{StaticResource ModernDangerButton}" Content="🗑️ Format Userdata (Safe)" Command="{Binding MtkFormatUserdataCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Hapus pola/PIN layar aman tanpa hilang sinyal"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Background="#DC2626" BorderBrush="#DC2626" Content="⚡ Force BROM (Crash PL)" Command="{Binding MtkCrashPreloaderCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Paksa masuk BROM mode dari Preloader"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🛡️ Bypass SLA / DAA Auth" Command="{Binding AuthBypassCommand}" Height="34" FontSize="12" ToolTip="Bypass autentikasi SLA/DAA MTK"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Bootloader & Mode -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="🔓 BOOTLOADER &amp; MODE" FontWeight="Bold" FontSize="11" Foreground="#7E22CE" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔓 Unlock BL (UBL Instant)" Command="{Binding MtkUnlockBootloaderCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Buka kunci bootloader instan tanpa waktu tunggu via modifikasi seccfg"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔒 Relock Bootloader" Command="{Binding MtkRelockBootloaderCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Kunci kembali bootloader ke status official locked (AVB aktif)"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔄 Reboot Normal (System)" Command="{Binding RebootNormalCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Kirim instruksi hardware reset untuk keluar dari BROM dan menyalakan HP normal"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Reboot BROM / Preloader" Command="{Binding MtkRebootCommand}" Height="34" FontSize="12" ToolTip="Paksa transisi Preloader ke BROM murni atau panduan tombol fisik hardware"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Security & NVRAM -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="💾 KEAMANAN &amp; NVRAM" FontWeight="Bold" FontSize="11" Foreground="#15803D" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernSuccessButton}" Content="💾 Backup NVRAM / NVDATA" Command="{Binding MtkBackupNvramCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Cadangkan partisi nvram, nvdata, dan nvcfg untuk proteksi IMEI &amp; Baseband"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Restore NVRAM / NVDATA" Command="{Binding MtkRestoreNvramCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Pulihkan partisi NVRAM/NVDATA dari direktori cadangan biner (.bin)"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📑 Read GPT Partition Table" Command="{Binding MtkReadGptCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Baca dan tampilkan tabel susunan partisi GUID (GPT) dari eMMC/UFS"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📶 Fix Baseband Radio MTK" Command="{Binding FixBasebandCommand}" Height="34" FontSize="12" ToolTip="Perbaiki Baseband Unknown / Sinyal Hilang via injeksi kalibrasi NVRAM bersih"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Special MTK Operations -->
                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🛠️ OPERASI KHUSUS MTK" FontWeight="Bold" FontSize="11" Foreground="#B45309" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Permanent Disable DAA" Command="{Binding AuthBypassCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Nonaktifkan autentikasi DAA MTK secara permanen"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📦 Dump Partisi eMMC / UFS" Command="{Binding ReadPartitionCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Baca dan ekstrak partisi mentah dari chip memori eMMC/UFS"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📶 Repair / Write IMEI" Command="{Binding RepairImeiCommand}" Height="34" FontSize="12" ToolTip="Tulis ulang nomor IMEI resmi perangkat MediaTek"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Reset Port COM USB" Command="{Binding ForceResetUsbPortsCommand}" Height="34" FontSize="12" ToolTip="Bersihkan buffer COM port yang macet dan refresh Device Manager Windows"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- INDEX 2: ⚡ QUALCOMM (EDL 9008 / FIREHOSE) -->
            <TabItem>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: FRP & Format EDL -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="🛡️ KUNCI LAYAR &amp; FRP" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="⚡ Erase FRP (EDL 9008)" Command="{Binding EdlBypassFrpCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernDangerButton}" Content="🗑️ Format Userdata (EDL)" Command="{Binding EdlFormatUserdataCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📑 Read GPT via Firehose" Command="{Binding EdlReadGptCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="⚡ Auto-Detect Firehose" Command="{Binding EnsureLoaderCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Mode & Power Control -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="📥 MODE &amp; POWER CONTROL" FontWeight="Bold" FontSize="11" Foreground="#7E22CE" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔄 Reboot EDL ke Normal" Command="{Binding EdlRebootCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Reboot EDL ke EDL 9008" Command="{Binding RebootEdlCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔄 Reboot Normal (System)" Command="{Binding RebootNormalCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Reboot Recovery Mode" Command="{Binding RebootRecoveryCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: QCN & Baseband -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="💾 KALIBRASI QCN &amp; NV" FontWeight="Bold" FontSize="11" Foreground="#15803D" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernSuccessButton}" Content="💾 Backup EFS (EDL 9008)" Command="{Binding EdlBackupEfsCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Restore EFS (EDL 9008)" Command="{Binding EdlRestoreEfsCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📶 Enable Diag Port (ADB)" Command="{Binding EnableQualcommDiagPortCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📶 Repair IMEI / MEID" Command="{Binding RepairImeiCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Operations & Flash -->
                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🛠️ OPERASI FIREHOSE" FontWeight="Bold" FontSize="11" Foreground="#B45309" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🚀 Kirim Loader Sahara" Command="{Binding EdlFlashCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Flash RawProgram XML" Command="{Binding StartFirmwareFlashCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📦 Dump Partisi Terpilih" Command="{Binding ReadPartitionCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Reset Port 9008" Command="{Binding ForceResetUsbPortsCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- INDEX 3: ⚡ XIAOMI / REDMI (SIDELOAD / MI CLOUD) -->
            <TabItem>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Mi Cloud & Sideload -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="🛡️ MI CLOUD &amp; SIDELOAD" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="🛡️ Bypass Mi Cloud (EDL/Sideload)" Command="{Binding RemoveMiAccountCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernDangerButton}" Content="🗑️ Sideload Format Userdata" Command="{Binding XiaomiSideloadFormatCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Sideload Erase FRP" Command="{Binding XiaomiSideloadFrpCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
