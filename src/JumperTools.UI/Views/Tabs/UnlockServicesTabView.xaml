                            <Button Style="{StaticResource ModernPrimaryButton}" Content="📥 Masuk Recovery Mode" Command="{Binding AppleEnterRecoveryCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="🔄 Keluar Recovery (Exit)" Command="{Binding AppleExitRecoveryCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔄 Reboot Normal (System)" Command="{Binding AppleRebootNormalCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📋 Panduan Tombol DFU Mode" Command="{Binding AppleShowDfuGuideCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Backup & Restore iOS -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="💾 CADANGAN &amp; PEMULIHAN" FontWeight="Bold" FontSize="11" Foreground="#15803D" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernSuccessButton}" Content="💾 Backup Data via Apple API" Command="{Binding AppleBackupCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Restore Cadangan Apple" Command="{Binding AppleRestoreCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📶 Status Koneksi USB" Command="{Binding AppleDiagnoseUsbMuxCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🧹 Bersihkan Log Konsol" Command="{Binding ClearLogCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Flashing IPSW -->
                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🛠️ FLASHING &amp; UTILITAS IPSW" FontWeight="Bold" FontSize="11" Foreground="#B45309" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Flash IPSW Firmware" Command="{Binding StartFirmwareFlashCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📂 Pilih Berkas IPSW" Command="{Binding BrowseFirmwareFileCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Fix Bootloop Logo Apple" Command="{Binding AppleExitRecoveryCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📋 Salin Serial / UDID" Command="{Binding CopyLogCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- INDEX 9: ⚡ REFURBISHED ROM AUDIT & CLEANER -->
            <TabItem>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Audit Keaslian Hardware -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="🔍 AUDIT KEASLIAN HARDWARE" FontWeight="Bold" FontSize="11" Foreground="#0369A1" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="🔍 Audit ROM Distributor / Fake" Command="{Binding AuditRefurbishedRomCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Audit fingerprint ROM, bloatware toko, dan identitas asli"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔍 Cek Sensor Fisik Asli" Command="{Binding AuditPhysicalSensorsCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Uji keberadaan sensor fisik Gyro/Accel/Proximity asli"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔍 Cek Resolusi Layar &amp; GPU" Command="{Binding AuditDisplayGpuCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Baca resolusi frame buffer asli &amp; driver GPU OpenGL"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔍 Cek RAM &amp; eMMC Asli" Command="{Binding AuditRamStorageCommand}" Height="34" FontSize="12" ToolTip="Baca kapasitas RAM kernel murni &amp; serial CID eMMC/UFS"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Pembersihan Malware -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="🧹 PEMBERSIHAN BLOATWARE" FontWeight="Bold" FontSize="11" Foreground="#7E22CE" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernDangerButton}" Content="🗑️ Hapus Bloatware Distributor" Command="{Binding CleanRefurbishedRomCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Bersihkan adware dan aplikasi pelacak toko"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="🛡️ Hapus Adware &amp; Backdoor" Command="{Binding CleanRefurbishedRomCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Normalisasi sistem ke kondisi stock bersih"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔄 Reboot Normal (System)" Command="{Binding RebootNormalCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Reboot Recovery Mode" Command="{Binding RebootRecoveryCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Cadangan Partisi Asli -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="💾 CADANGAN PARTISI ASLI" FontWeight="Bold" FontSize="11" Foreground="#15803D" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernSuccessButton}" Content="💾 Backup Partisi Aman (Dump)" Command="{Binding ReadPartitionCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📥 Restore Partisi Asli" Command="{Binding WritePartitionCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📶 Verifikasi IMEI Asli Pabrik" Command="{Binding RepairImeiCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📶 Fix Sinyal Hilang" Command="{Binding FixBasebandCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Flash ROM Global Resmi -->
                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🛠️ FLASH ROM RESMI" FontWeight="Bold" FontSize="11" Foreground="#B45309" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Content="⚡ Flash ROM Global Resmi" Command="{Binding StartFirmwareFlashCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📂 Pilih Paket Fastboot ROM" Command="{Binding BrowseFirmwareFileCommand}" Height="34" Margin="0,0,0,5" FontSize="11"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🔒 Kunci Kembali Bootloader" Command="{Binding FastbootLockCommand}" Height="34" Margin="0,0,0,5" FontSize="11" ToolTip="Kunci kembali bootloader ke status official locked (AVB aktif)"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="⚡ Reset Port COM USB" Command="{Binding ForceResetUsbPortsCommand}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ROW 3: OPERATION PROGRESS BAR -->
        <Grid Grid.Row="3" Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Status: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBlock Text="{Binding CurrentOperation}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding OperationProgress, StringFormat='{}{0}%'}" FontWeight="Bold" Foreground="#0284C7" FontSize="11"/>
            <ProgressBar Grid.ColumnSpan="2" Value="{Binding OperationProgress}" Maximum="100" Height="4" VerticalAlignment="Bottom" Margin="0,18,0,0" Foreground="#0284C7" Background="#E2E8F0" BorderThickness="0"/>
        </Grid>

        <!-- ROW 4: DOCKED LIVE TERMINAL CONSOLE (COMPACT & PROPORTIONAL) -->
        <Border Grid.Row="4" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Console Title Bar -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="8,8,0,0" Padding="14,6">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                            <TextBlock Text="TERMINAL OUTPUT" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11.5" FontFamily="{StaticResource ConsoleFontFamily}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ModernActionButton}" Content="⏹️ Stop / Batal" Command="{Binding CancelCurrentOperationCommand}" Padding="12,4" FontSize="11" FontWeight="SemiBold" Background="#991B1B" Foreground="#FEF2F2" BorderThickness="0" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="📋 Salin Log" Command="{Binding CopyLogCommand}" Padding="12,4" FontSize="11" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ModernActionButton}" Content="🧹 Bersihkan" Command="{Binding ClearLogCommand}" Padding="12,4" FontSize="11" Background="#334155" Foreground="#FCA5A5" BorderThickness="0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Console Content -->
                <TextBox Grid.Row="1" x:Name="ConsoleTextBox"
                         Text="{Binding TerminalLogText, Mode=OneWay}"
                         Background="#0A0F1D"
                         Foreground="#38BDF8"
                         FontFamily="{StaticResource ConsoleFontFamily}"
                         FontSize="11.5"
                         FontWeight="Normal"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Padding="12,8"
                         TextChanged="ConsoleTextBox_TextChanged"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
