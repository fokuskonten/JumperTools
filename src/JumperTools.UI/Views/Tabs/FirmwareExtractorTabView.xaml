<UserControl x:Class="JumperTools.UI.Views.Tabs.FirmwareExtractorTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar & Extraction Format Selectors -->
        <Border Grid.Row="0" Style="{StaticResource ModernEnterpriseCard}" Padding="12,10" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Ekstraksi Firmware (OFP, TAR, Scatter, XML, Payload)" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                        <Button Style="{StaticResource SmallInfoBadgeButton}" Command="{Binding ShowFeatureGuideCommand}" CommandParameter="Tab_FirmwareExtractor" ToolTip="Panduan &amp; Informasi Ekstrak Firmware"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                        <TextBlock Text="Format: .ofp | .tar.md5 | payload.bin | scatter.txt | rawprogram.xml" Foreground="#334155" FontWeight="Bold" FontSize="10.5"/>
                    </Border>
                </DockPanel>

                <!-- File Selector -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding FirmwareFilePath, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource SharpTextBox}" 
                             Height="26" Margin="0,0,5,0" FontSize="10.5"/>
                    <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" Content="📂 Pilih File..." Command="{Binding BrowseFirmwareFileCommand}" Padding="8,3" FontSize="10.5"/>
                </Grid>
                         
                <!-- Extraction Action Buttons -->
                <WrapPanel>
                    <Button Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" BorderBrush="#0284C7" Content="📦 Ekstrak payload.bin" Command="{Binding ExtractPayloadBinCommand}" Margin="0,0,5,4" Padding="8,3" FontSize="10.5" IsEnabled="{Binding HasFirmwareFileSelected}" ToolTip="Ekstrak arsip Android OTA payload.bin ke file image partisi"/>
                    <Button Style="{StaticResource ModernActionButton}" Content="🔓 Ekstrak Oppo OFP" Command="{Binding ExtractOfpCommand}" Margin="0,0,5,4" Padding="8,3" FontSize="10.5" IsEnabled="{Binding HasFirmwareFileSelected}" ToolTip="Dekripsi &amp; ekstrak file OFP Oppo / Realme"/>
                    <Button Style="{StaticResource ModernActionButton}" Content="📂 Ekstrak Samsung TAR" Command="{Binding ExtractSamsungTarCommand}" Margin="0,0,5,4" Padding="8,3" FontSize="10.5" IsEnabled="{Binding HasFirmwareFileSelected}" ToolTip="Ekstrak arsip Samsung .tar / .tar.md5"/>
                    <Button Style="{StaticResource ModernActionButton}" Content="📑 Baca MTK Scatter" Command="{Binding ParseScatterCommand}" Margin="0,0,5,4" Padding="8,3" FontSize="10.5" IsEnabled="{Binding HasFirmwareFileSelected}" ToolTip="Baca dan petakan file layout MTK scatter.txt"/>
                    <Button Style="{StaticResource ModernActionButton}" Content="📑 Baca Qualcomm XML" Command="{Binding ParseRawProgramCommand}" Margin="0,0,5,4" Padding="8,3" FontSize="10.5" IsEnabled="{Binding HasFirmwareFileSelected}" ToolTip="Baca dan petakan file rawprogram0.xml"/>
                    <Button Style="{StaticResource ModernActionButton}" Content="📂 Buka Folder Hasil" Command="{Binding OpenExtractedFolderCommand}" Margin="0,0,5,4" Padding="8,3" FontSize="10.5" ToolTip="Buka direktori penyimpanan file hasil ekstraksi di Windows Explorer"/>
                    <Button Style="{StaticResource ModernPrimaryButton}" Background="#16A34A" BorderBrush="#16A34A" Content="⚡ Flash ke HP" Command="{Binding FlashExtractedFilesCommand}" Margin="0,0,0,4" Padding="8,3" FontSize="10.5" IsEnabled="{Binding HasExtractedFiles}" ToolTip="Flash berurutan seluruh partisi hasil ekstraksi ke HP — hanya aktif setelah ekstraksi selesai"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- BOTTOM WORKBENCH: 2-COLUMN SPLIT (EXTRACTED FILES + LIVE EXTRACTION LOG TERMINAL) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Extracted Partition File Table -->
            <Border Grid.Column="0" Style="{StaticResource ModernEnterpriseCard}" Padding="4" Margin="0,0,6,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding ExtractedFiles}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" Background="#FFFFFF">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Partisi" Binding="{Binding PartitionName}" FontWeight="Bold" Width="120"/>
                            <DataGridTextColumn Header="Ukuran" Binding="{Binding FileSizeFormatted}" Width="85"/>
                            <DataGridTextColumn Header="Nama File .img" Binding="{Binding FileName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State Helper -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,12" Visibility="{Binding HasNoExtractedFiles, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦 Belum Ada Berkas yang Diekstrak" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Pilih file firmware di atas lalu klik tombol ekstrak yang sesuai." Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Live Firmware Decompression Log Terminal -->
            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Terminal Header Bar -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="6,6,0,0" Padding="10,4">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="FIRMWARE EXTRACTION &amp; DECOMPRESSION STREAM" Foreground="#E2E8F0" FontWeight="Bold" FontSize="10.5" FontFamily="Consolas, Cascadia Code, Courier New"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ModernActionButton}" Content="📋 Salin Log" Command="{Binding CopyLogCommand}" Padding="6,2" FontSize="9.5" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource ModernActionButton}" Content="🧹 Bersihkan" Command="{Binding ClearLogCommand}" Padding="6,2" FontSize="9.5" Background="#334155" Foreground="#FCA5A5" BorderThickness="0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Terminal Log Body -->
                    <TextBox Grid.Row="1" Text="{Binding TerminalLogText, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="Transparent"
                             Foreground="#38BDF8"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="11.5"
                             FontWeight="Medium"
                             BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="Wrap"
                             SelectionBrush="#0284C7"
                             Padding="10"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
