<UserControl x:Class="JumperTools.UI.Views.Tabs.ReadInfoTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Focused Action Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: 4-Column Balanced Spec Dashboard -->
            <RowDefinition Height="*"/>    <!-- Row 2: Live Forensic Log Stream (Zero Void) -->
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP ACTION TOOLBAR -->
        <Border Grid.Row="0" Style="{StaticResource ModernEnterpriseCard}" Padding="12,10" Margin="0,0,0,8">
            <DockPanel>
                <!-- Left CTAs -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" BorderBrush="#0284C7"
                            Command="{Binding ReadDeviceInfoCommand}" Padding="16,8" FontSize="12" FontWeight="Bold" Margin="0,0,10,0"
                            ToolTip="Pindai dan baca otomatis info hardware, bootloader, FRP, dan baterai dari HP">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="Baca Info Perangkat (Read Info)"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernActionButton}" Command="{Binding ScanUsbCommand}" Padding="14,8" FontSize="11.5" Margin="0,0,8,0" ToolTip="Pindai ulang port USB untuk mendeteksi HP">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="11"/>
                            <TextBlock Text="Scan Port USB"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallInfoBadgeButton}" Command="{Binding ShowFeatureGuideCommand}" CommandParameter="Tab_ReadInfoForensic" ToolTip="Panduan &amp; Forensik Read Info"/>
                </StackPanel>

                <!-- Right CTAs -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernActionButton}" Command="{Binding CopyReadInfoLogCommand}" Padding="14,8" FontSize="11.5" Margin="0,0,8,0" ToolTip="Salin seluruh teks hasil forensik">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,6,0" FontSize="11"/>
                            <TextBlock Text="Salin Info"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernActionButton}" Command="{Binding ClearReadInfoLogCommand}" Padding="14,8" FontSize="11.5" ToolTip="Bersihkan tampilan log">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" Margin="0,0,6,0" FontSize="11"/>
                            <TextBlock Text="Bersihkan"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: 4-COLUMN HORIZONTAL SPEC DASHBOARD (ZERO VOID) -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Profil Perangkat -->
            <Border Grid.Column="0" Style="{StaticResource ModernEnterpriseCard}" Padding="14,12" Margin="0,0,6,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📱" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="PROFIL PERANGKAT" FontWeight="Bold" FontSize="11" Foreground="#0284C7"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding InfoConnectionMode, FallbackValue='Auto (ADB/FB/MTP)'}" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding InfoModel, FallbackValue='Menunggu Pembacaan...'}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding InfoBrand, FallbackValue='Hubungkan HP lalu klik Baca Info'}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Identitas Hardware -->
            <Border Grid.Column="1" Style="{StaticResource ModernEnterpriseCard}" Padding="14,12" Margin="0,0,6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⚙️" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="IDENTITAS HARDWARE" FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Serial / USB ID:" FontSize="10.5" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoSerialNumber, FallbackValue='-'}" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Brand / Pabrikan:" FontSize="10.5" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoBrand, FallbackValue='-'}" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Mode Port:" FontSize="10.5" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoConnectionMode, FallbackValue='Auto COM / USB'}" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Keamanan & Kunci -->
            <Border Grid.Column="2" Style="{StaticResource ModernEnterpriseCard}" Padding="14,12" Margin="0,0,6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔒" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="KEAMANAN &amp; KUNCI" FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Bootloader (UBL):" FontSize="10.5" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoBootloader, FallbackValue='-'}" FontWeight="Bold" FontSize="10.5" Foreground="{Binding InfoBootloaderColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Akun Google (FRP):" FontSize="10.5" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoGoogleFrp, FallbackValue='-'}" FontWeight="Bold" FontSize="10.5" Foreground="{Binding InfoGoogleFrpColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Security Patch:" FontSize="10.5" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoSecurityPatch, FallbackValue='-'}" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 4: Daya & Sistem -->
            <Border Grid.Column="3" Style="{StaticResource ModernEnterpriseCard}" Padding="14,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="DAYA &amp; KAPASITAS" FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Level Baterai:" FontSize="10.5" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoBattery, FallbackValue='-'}" FontWeight="Bold" FontSize="10.5" Foreground="{Binding InfoBatteryColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Total RAM Fisik:" FontSize="10.5" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoRam, FallbackValue='-'}" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Versi Android:" FontSize="10.5" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoAndroidVer, FallbackValue='-'}" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: LIVE FORENSIC LOG TERMINAL (DOCKED FLUSH & ZERO VOID) -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Terminal Header Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="LOG FORENSIK HASIL PEMBACAAN IDENTITAS &amp; HARDWARE PERANGKAT" FontWeight="Bold" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </DockPanel>

                <!-- Terminal Output Text -->
                <TextBox Grid.Row="1"
                         Text="{Binding ReadInfoLogText, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#38BDF8"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12"
                         FontWeight="Medium"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextWrapping="Wrap"
                         SelectionBrush="#0284C7"
                         Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
