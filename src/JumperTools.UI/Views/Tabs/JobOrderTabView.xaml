<UserControl x:Class="JumperTools.UI.Views.Tabs.JobOrderTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*"/> <!-- Left: Expanded Width for Comfortable CRM Form -->
            <ColumnDefinition Width="*"/>     <!-- Right: Thermal Receipt Preview -->
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: FORM INPUT NOTA & RIWAYAT TRANSAKSI (CRM) -->
        <Grid Grid.Column="0" Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Form Input Card -->
                <RowDefinition Height="*"/>    <!-- Row 1: Riwayat Nota DataGrid (Fills to Bottom) -->
            </Grid.RowDefinitions>

            <!-- FORM INPUT NOTA SERVIS -->
            <Border Grid.Row="0" Style="{StaticResource ModernEnterpriseCard}" Padding="16,14" Margin="0,0,0,8">
                <StackPanel>
                    <!-- Card Header -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧾" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="BUAT NOTA SERVIS (CRM KASIR)" FontWeight="Bold" FontSize="12" Foreground="#15803D"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallInfoBadgeButton}" Command="{Binding ShowFeatureGuideCommand}" CommandParameter="Tab_ServiceCrm" ToolTip="Panduan Nota Servis"/>
                    </DockPanel>

                    <!-- Row 1: Nama Pelanggan & WhatsApp -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Nama Pelanggan:" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SharpTextBox}" materialDesign:HintAssist.Hint="Contoh: Budi Santoso" Height="34" FontSize="12" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Nomor WhatsApp:" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SharpTextBox}" materialDesign:HintAssist.Hint="Contoh: 08123456789" Height="34" FontSize="12" Padding="8,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Brand & Model HP -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Brand HP:" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding NewDeviceBrand, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SharpTextBox}" materialDesign:HintAssist.Hint="Contoh: Samsung" Height="34" FontSize="12" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Model HP / Seri:" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding NewDeviceModel, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SharpTextBox}" materialDesign:HintAssist.Hint="Contoh: Galaxy A52" Height="34" FontSize="12" Padding="8,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: Keluhan / Layanan -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Keluhan / Layanan Servis:" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NewServiceType, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource SharpTextBox}" materialDesign:HintAssist.Hint="Contoh: Bypass FRP / Ganti LCD / Flash Firmware" Height="34" FontSize="12" Padding="8,6"/>
                    </StackPanel>

                    <!-- Row 4: Biaya & Garansi -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Biaya Servis (Rp):" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding NewCost, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SharpTextBox}" Height="34" FontSize="12" FontWeight="Bold" Foreground="#15803D" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Garansi (Hari):" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding NewWarrantyDays, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SharpTextBox}" Height="34" FontSize="12" Padding="8,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 5: Action CTAs -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ModernPrimaryButton}" Background="#16A34A" BorderBrush="#16A34A" 
                                Command="{Binding CreateJobOrderCommand}" Height="36" FontSize="12" FontWeight="Bold" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Simpan &amp; Terbitkan Nota"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource ModernActionButton}" 
                                Command="{Binding AutoFillJobFromDeviceCommand}" Height="36" FontSize="11.5" Padding="14,0" ToolTip="Salin brand dan model dari HP yang terhubung">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱" Margin="0,0,6,0" FontSize="11.5"/>
                                <TextBlock Text="Salin dari HP"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RIWAYAT NOTA SERVIS DATAGRID (FILLS REMAINING HEIGHT) -->
            <Border Grid.Row="1" Style="{StaticResource ModernEnterpriseCard}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="RIWAYAT NOTA SERVIS KASIR" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding JobOrders}" SelectedItem="{Binding SelectedJobOrder}" 
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" 
                              BorderThickness="1" BorderBrush="#E2E8F0" Background="#FFFFFF">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No. Nota" Binding="{Binding JobId, StringFormat='#{0}'}" FontWeight="Bold" Width="110"/>
                            <DataGridTextColumn Header="Pelanggan" Binding="{Binding CustomerName}" Width="120"/>
                            <DataGridTextColumn Header="Perangkat" Binding="{Binding DeviceModel}" Width="130"/>
                            <DataGridTextColumn Header="Biaya" Binding="{Binding Cost, StringFormat='Rp {0:N0}'}" FontWeight="Bold" Foreground="#15803D" Width="100"/>
                            <DataGridTextColumn Header="Tanggal" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State -->
                    <Border Grid.Row="1" Background="#FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding HasNoJobOrders, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Belum Ada Riwayat Transaksi Nota" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" HorizontalAlignment="Center"/>
                            <TextBlock Text="Isi form di atas lalu klik 'Simpan &amp; Terbitkan Nota'." Foreground="#64748B" FontSize="10.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT COLUMN: REALISTIC THERMAL RECEIPT PREVIEW & ACTIONS -->
        <Border Grid.Column="1" Style="{StaticResource ModernEnterpriseCard}" Padding="16,14" Margin="4,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Paper Canvas -->
                    <RowDefinition Height="Auto"/> <!-- Action Footer -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖨️" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="PRATINJAU STRUK THERMAL (58mm / 80mm)" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                        <TextBlock Text="Live Draft Preview" FontWeight="Bold" Foreground="#334155" FontSize="10.5"/>
                    </Border>
                </DockPanel>

                <!-- Thermal Paper Preview Canvas -->
                <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <!-- Centered Thermal Paper Card -->
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" 
                                MaxWidth="360" HorizontalAlignment="Center" Padding="14,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                            </Border.Effect>
                            <TextBox Text="{Binding ReceiptPreviewText, Mode=OneWay}" 
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" FontWeight="Medium" 
                                     Foreground="#0F172A" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="NoWrap"/>
                        </Border>
                    </ScrollViewer>
                </Border>

                <!-- Action Footer (Clean Grid - Zero Overlap!) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="💡 Kompatibel printer POS USB &amp; Bluetooth" Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" BorderBrush="#0284C7" 
                                Command="{Binding PrintReceiptCommand}" Height="34" FontSize="11.5" FontWeight="Bold" Margin="0,0,6,0" Padding="14,0"
                                ToolTip="Buka format cetak nota untuk dikirim ke printer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Cetak Struk"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModernPrimaryButton}" Background="#16A34A" BorderBrush="#16A34A" 
                                Command="{Binding SendWhatsAppReceiptCommand}" Height="34" FontSize="11.5" FontWeight="Bold" Padding="14,0"
                                ToolTip="Kirim rincian nota langsung ke nomor WhatsApp pelanggan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Kirim WhatsApp"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
