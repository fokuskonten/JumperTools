<UserControl x:Class="JumperTools.UI.Views.Tabs.CustomRecoveryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Top Header Toolbar & Portals -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Full-Width Flash & Partition Control Center -->
            <RowDefinition Height="*"/>    <!-- Row 2: Live Fastboot Terminal Output (Zero Void) -->
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP HEADER TOOLBAR & OFFICIAL PORTALS -->
        <Border Grid.Row="0" Style="{StaticResource ModernEnterpriseCard}" Padding="14,10" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" Foreground="#7E22CE"/>
                    <TextBlock Text="Pemasangan Custom Recovery" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                    <TextBlock Text=" (TWRP / OrangeFox / PBRP)" FontWeight="SemiBold" FontSize="12.5" Foreground="#7E22CE"/>
                    <Button Style="{StaticResource SmallInfoBadgeButton}" Command="{Binding ShowFeatureGuideCommand}" CommandParameter="Tab_RecoveryHub" ToolTip="Panduan Custom Recovery" Margin="6,0,0,0"/>
                    <TextBlock Text=" — Fastboot Direct Flash &amp; RAM Boot" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="8,1,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernActionButton}" Command="{Binding OpenOfficialTwrpWebCommand}" Margin="0,0,6,0" Padding="12,6" FontSize="11" ToolTip="Buka portal download resmi TWRP (twrp.me/Devices)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,6,0" FontSize="11"/>
                            <TextBlock Text="TWRP Resmi"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernActionButton}" Command="{Binding OpenOfficialOrangeFoxWebCommand}" Margin="0,0,6,0" Padding="12,6" FontSize="11" ToolTip="Buka portal download resmi OrangeFox (orangefox.download)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,6,0" FontSize="11"/>
                            <TextBlock Text="OrangeFox"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernActionButton}" Command="{Binding OpenRecoveryFolderCommand}" Padding="12,6" FontSize="11" ToolTip="Buka folder database recovery di Windows Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,6,0" FontSize="11"/>
                            <TextBlock Text="Folder Database"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: FULL-WIDTH RECOVERY FILE & PARTITION CONTROL CENTER -->
        <Border Grid.Row="1" Style="{StaticResource ModernEnterpriseCard}" Padding="16,14" Margin="0,0,0,8">
            <StackPanel>
                <!-- Line 1: Recovery Image File Picker -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="File Recovery (.img):" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1" Text="{Binding CustomRecoveryFilePath, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource SharpTextBox}" 
                             materialDesign:HintAssist.Hint="Pilih file custom recovery (*.img) yang akan dipasang..."
                             Height="34" Margin="0,0,8,0" FontSize="11.5" VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2" Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" BorderBrush="#0284C7" 
                            Command="{Binding BrowseCustomRecoveryCommand}" Margin="0,0,6,0" Padding="14,7" FontSize="11.5" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,6,0" FontSize="12"/>
                            <TextBlock Text="Cari File .img"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Grid.Column="3" Style="{StaticResource ModernActionButton}" 
                            Command="{Binding ClearCustomRecoveryFileCommand}" Padding="12,7" FontSize="11.5" ToolTip="Kosongkan pilihan file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,6,0" FontSize="11"/>
                            <TextBlock Text="Reset"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Line 2: Partition Target, AVB Option, and Primary Execution CTAs -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Target Partition -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Target Partisi:" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding TargetPartitionList}" SelectedItem="{Binding SelectedTargetPartition}" Width="190" Height="32" FontSize="11.5" FontWeight="SemiBold" VerticalContentAlignment="Center" Background="#FFFFFF"/>
                    </StackPanel>

                    <!-- Patch vbmeta Checkbox -->
                    <CheckBox Grid.Column="1" IsChecked="{Binding DisableAvbVerityOnFlash}" Content="Patch vbmeta (Nonaktifkan AVB / Verity)" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" BorderBrush="#0284C7"
                                Command="{Binding InstallSelectedRecoveryCommand}" Margin="0,0,10,0" Padding="18,8" FontSize="12" FontWeight="Bold" 
                                ToolTip="Flash custom recovery ke partisi target via Fastboot secara permanen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,6,0" FontSize="13"/>
                                <TextBlock Text="Flash Recovery (Permanen)"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModernActionButton}" 
                                Command="{Binding BootSelectedRecoveryCommand}" Padding="16,8" FontSize="12" FontWeight="SemiBold" 
                                ToolTip="Boot sementara ke recovery tanpa menulis permanen (fastboot boot recovery.img)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Boot RAM (Sementara)"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 2: LIVE FASTBOOT FLASHING LOG TERMINAL (DOCKED FLUSH & ZERO VOID) -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Terminal Header Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="LOG TERMINAL EKSEKUSI FASTBOOT RECOVERY" FontWeight="Bold" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModernActionButton}" Command="{Binding CopyLogCommand}" Padding="10,4" FontSize="10.5" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Margin="0,0,6,0" FontSize="10.5"/>
                                <TextBlock Text="Salin Log"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModernActionButton}" Command="{Binding ClearLogCommand}" Padding="10,4" FontSize="10.5" Background="#334155" Foreground="#FCA5A5" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" Margin="0,0,6,0" FontSize="10.5"/>
                                <TextBlock Text="Bersihkan"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Terminal Log Body -->
                <TextBox Grid.Row="1" Text="{Binding TerminalLogText, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#38BDF8"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12"
                         FontWeight="Medium"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         SelectionBrush="#0284C7"
                         Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
