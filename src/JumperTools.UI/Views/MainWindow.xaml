<Window x:Class="JumperTools.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:JumperTools.UI.Views"
        xmlns:tabs="clr-namespace:JumperTools.UI.Views.Tabs"
        xmlns:viewModels="clr-namespace:JumperTools.UI.ViewModels"
        xmlns:behaviors="clr-namespace:JumperTools.UI.Behaviors"
        mc:Ignorable="d"
        Title="JumperTools Pro - Universal Hardware &amp; Firmware Suite" 
        Icon="pack://application:,,,/JumperTools;component/Resources/app.ico"
        Height="840" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Grid Background="#F8FAFC">
        <!-- 1: TAB CONTROL WITH VERTICAL CRM SIDEBAR (Tab 1 s/d 11) -->
        <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" TabStripPlacement="Left">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="#F8FAFC">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDEBAR (Clean White ala CRM) -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Logo Header -->
                                    <RowDefinition Height="*"/>    <!-- Navigation Tab Items -->
                                    <RowDefinition Height="Auto"/> <!-- Footer / License -->
                                </Grid.RowDefinitions>

                                <!-- BRAND LOGO -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="8" Background="Transparent" ClipToBounds="True">
                                            <Image Source="pack://application:,,,/JumperTools;component/Resources/app_logo.png" 
                                                   Stretch="Uniform" 
                                                   RenderOptions.BitmapScalingMode="HighQuality" 
                                                   SnapsToDevicePixels="True"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="JumperTools" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                                <Border Background="#10B981" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="PRO" Foreground="#FFFFFF" FontWeight="Bold" FontSize="8.5"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Firmware &amp; Bypass Suite" Foreground="#64748B" FontSize="10.5" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Separator Margin="0,12,0,0" Background="#E2E8F0"/>
                                </StackPanel>

                                <!-- NAVIGATION TABS LIST -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                                </ScrollViewer>

                                <!-- FOOTER / LICENSE -->
                                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="PRO License (Official)" Foreground="#059669" FontWeight="Bold" FontSize="10.5"/>
                                        </DockPanel>
                                        <TextBlock Text="v1.8 | Standalone Offline" Foreground="#64748B" FontSize="9.5" Margin="13,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- RIGHT MAIN WORKSPACE CANVAS -->
                        <Grid Grid.Column="1" Margin="14,10,14,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top Action Header Bar -->
                                <RowDefinition Height="*"/>    <!-- Active Tab Workspace Content -->
                            </Grid.RowDefinitions>

                            <!-- TOP ACTION HEADER BAR (ERGONOMIC TECHNICIAN CONTROLS) -->
                            <Border Grid.Row="0" Style="{StaticResource ModernEnterpriseCard}" Padding="14,10" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ Master Workspace" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A"/>
                                        <TextBlock Text=" — Flasher &amp; Servis HP Pro" Foreground="#64748B" FontSize="12" Margin="6,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Quick Device Manager Button (1-Click for Technicians) -->
                                        <Button Style="{StaticResource ModernSecondaryButton}" Content="🖥️ Device Manager" Command="{Binding OpenDeviceManagerCommand}" Padding="12,5" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,10,0" ToolTip="Buka Windows Device Manager (devmgmt.msc)"/>
                                        
                                        <!-- License / Engine Status Badge (Commercial Standalone for Buyers) -->
                                        <Border Background="{Binding ServerStatusBgColor, FallbackValue='#F8FAFC'}" BorderBrush="{Binding ServerStatusBorderColor, FallbackValue='#CBD5E1'}" BorderThickness="1" CornerRadius="6" Padding="12,5">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{Binding ServerStatusDotColor, FallbackValue='#10B981'}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding ConnectionStatus, FallbackValue='License: Pro (Active)'}" Foreground="{Binding ServerStatusTextColor, FallbackValue='#0F172A'}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- ACTIVE TAB CONTENT -->
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- TAB 1: UNLOCK & SERVIS (ENTERPRISE HARDWARE & REPAIR WORKBENCH) -->
            <TabItem Header="🔓 Unlock &amp; Servis" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:UnlockServicesTabView/>
            </TabItem>

            <!-- TAB 2: ⚡ FLASHER FIRMWARE -->
            <TabItem Header="⚡ Flasher Firmware" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:FirmwareFlasherTabView/>
            </TabItem>

            <!-- TAB 3: 📑 PARTISI GPT -->
            <TabItem Header="📑 Partisi GPT" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:PartitionManagerTabView/>
            </TabItem>

            <!-- TAB 4: 📦 EKSTRAK FIRMWARE -->
            <TabItem Header="📦 Ekstrak Firmware" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:FirmwareExtractorTabView/>
            </TabItem>

            <!-- TAB 5: 🔥 FIREHOSE (EDL) -->
            <TabItem Header="🔥 Firehose (EDL)" Style="{StaticResource CrmVerticalTabItem}" DataContext="{Binding FirehoseFinder}">
                <tabs:FirehoseEdlTabView/>
            </TabItem>

            <!-- TAB 6: 📍 TEST POINT -->
            <TabItem Header="📍 Test Point" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:TestPointTabView/>
            </TabItem>

            <!-- TAB 7: 🧾 NOTA SERVIS -->
            <TabItem Header="🧾 Nota Servis" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:JobOrderTabView/>
            </TabItem>

            <!-- TAB 8: 🧰 DRIVER USB -->
            <TabItem Header="🧰 Driver USB" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:DriverAssistantTabView/>
            </TabItem>

            <!-- TAB 9: 📶 SINYAL & IMEI -->
            <TabItem Header="📶 Sinyal &amp; IMEI" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:SignalRepairTabView/>
            </TabItem>

            <!-- TAB 10: ⚡ CUSTOM RECOVERY -->
            <TabItem Header="⚡ Custom Recovery" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:CustomRecoveryTabView/>
            </TabItem>

            <!-- TAB 11: 📖 READ INFO PERANGKAT (STANDARD TECHNICIAN CONSOLE) -->
            <TabItem Header="📖 Read Info" Style="{StaticResource CrmVerticalTabItem}">
                <tabs:ReadInfoTabView/>
            </TabItem>

        </TabControl>

        <!-- 2: INTERACTIVE FEATURE GUIDE POPUP MODAL OVERLAY -->
        <Grid Grid.ColumnSpan="2" 
              Visibility="{Binding IsFeatureGuideOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#990F172A"
              Panel.ZIndex="9999">
            <!-- Modal Card -->
            <Border Background="#FFFFFF" 
                    BorderBrush="#0284C7" 
                    BorderThickness="1.5" 
                    CornerRadius="10" 
                    MaxWidth="760" 
                    MaxHeight="680" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Margin="24" 
                    Padding="22" 
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.4"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header: Title & Close -->
                        <RowDefinition Height="Auto"/> <!-- Risk Badge -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Content -->
                        <RowDefinition Height="Auto"/> <!-- Footer Action Button -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ModernActionButton}" 
                                Content="✕" FontWeight="Bold" FontSize="14" Width="30" Height="30" Padding="0"
                                Command="{Binding CloseFeatureGuideCommand}" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentFeatureGuide.Icon}" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentFeatureGuide.Title}" FontWeight="Bold" FontSize="16" Foreground="#0369A1"/>
                                <TextBlock Text="{Binding CurrentFeatureGuide.Category, StringFormat='Kategori: {0}'}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Risk Level Banner -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{Binding CurrentFeatureGuide.RiskBadgeColor}" BorderThickness="1.5" CornerRadius="6" Padding="10,6" Margin="0,0,0,14">
                        <DockPanel>
                            <TextBlock Text="{Binding CurrentFeatureGuide.RiskBadgeText}" FontWeight="Bold" FontSize="11.5" Foreground="{Binding CurrentFeatureGuide.RiskBadgeColor}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentFeatureGuide.RiskDescription}" Foreground="#475569" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Scrollable Detailed Guide Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- 1. Deskripsi & Fungsi -->
                            <TextBlock Text="📖 Fungsi &amp; Cara Kerja:" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentFeatureGuide.Description}" TextWrapping="Wrap" LineHeight="19" FontSize="12" Foreground="#334155" Margin="0,0,0,12"/>

                            <!-- 2. Kapan Digunakan -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎯 Kapan Harus Digunakan?" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CurrentFeatureGuide.WhenToUse}" TextWrapping="Wrap" LineHeight="18" FontSize="11.5" Foreground="#334155"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. Syarat Sebelum Eksekusi -->
                            <TextBlock Text="📋 Syarat Sebelum Aksi:" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding CurrentFeatureGuide.Prerequisites}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <TextBlock Text="• " FontWeight="Bold" Foreground="#0284C7" FontSize="12"/>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="#334155"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 4. Panduan Langkah Fisik Teknisi -->
                            <TextBlock Text="🛠️ Panduan Langkah Fisik Teknisi:" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,12">
                                <ItemsControl ItemsSource="{Binding CurrentFeatureGuide.StepByStepGuide}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="19" FontSize="11.5" Foreground="#1E293B" Margin="0,2,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- 5. Troubleshooting & Solusi -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="💡 Solusi Jika Gagal / Kendala:" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CurrentFeatureGuide.Troubleshooting}" TextWrapping="Wrap" LineHeight="18" FontSize="11.5" Foreground="#334155"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Action Button -->
                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ModernPrimaryButton}" 
                                Content="✓ Mengerti &amp; Tutup Panduan" 
                                Command="{Binding CloseFeatureGuideCommand}" 
                                Padding="16,6" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
